includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    tmpDir: build/phpstan
    ignoreErrors:
        # Grid::macro() binds $this to the Grid component at runtime; the @var
        # $this annotation is the documented way to type such closures.
        - identifier: varTag.nativeType
          path: src/Macros/*
        # jDate(), jDateTime(), localeDigit() and toEN() are registered on
        # Filament components at runtime by fb-essentials' macro providers, so
        # PHPStan cannot resolve them statically.
        - message: '#(jDate|jDateTime|localeDigit|toEN)\(\)#'
          path: src
        # Traits are shipped for consumers to use; they are intentionally not
        # used in src/.
        - identifier: trait.unused
          path: src/Traits/*
