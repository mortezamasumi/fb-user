includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    tmpDir: build/phpstan
    ignoreErrors:
        # Grid::macro() binds $this to the Grid component at runtime; the @var
        # $this annotation is the documented way to type such closures.
        - identifier: varTag.nativeType
          path: src/Macros/*
        # jDate(), jDateTime(), localeDigit() and toEN() are registered on
        # Filament components at runtime by fb-essentials' macro providers, so
        # PHPStan cannot resolve them statically.
        - message: '#(jDate|jDateTime|localeDigit|toEN)\(\)#'
          path: src
        # The no-role-widget view lives in the package's own view namespace,
        # which PHPStan cannot resolve into a real path for the view-string
        # check on the Widget::$view default.
        - identifier: property.defaultValue
          path: src/Widgets/NoRoleWidget.php
        # HasCascadeOperation is consumed by app models (e.g. Student, Nurse)
        # that do not use spatie/laravel-permission; the method_exists guard
        # is a real runtime check, even though User (in src) always has hasRole.
        - identifier: function.alreadyNarrowedType
          path: src/Traits/HasCascadeOperation.php
        # Traits are shipped for consumers to use; they are intentionally not
        # used in src/.
        - identifier: trait.unused
          path: src/Traits/*
